"use strict";
var wall = document.querySelector(".wall");
var spider = document.querySelector(".spider");
wall.addEventListener("click", function(e) {
    var wallRect = wall.getBoundingClientRect();
    var spiderWidth = spider.offsetWidth;
    var spiderHeight = spider.offsetHeight;
    var left = e.clientX - wallRect.left - spiderWidth / 2;
    var spiderTop = e.clientY - wallRect.top - spiderHeight / 2;
    left = Math.max(0, Math.min(left, wallRect.width - spiderWidth));
    spiderTop = Math.max(0, Math.min(spiderTop, wallRect.height - spiderHeight));
    spider.style.left = "".concat(left, "px");
    spider.style.top = "".concat(spiderTop, "px");
});

